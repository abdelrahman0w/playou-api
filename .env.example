# Copy to `.env` and adjust, anything left out falls back to its default
# The values below are the defaults, or what the local docker compose services use

# App
APP_ENVIRONMENT=DEV
# Defaults to the commit the image is built from
# APP_VERSION=
APP_LOG_LEVEL=INFO
APP_LOG_JSON=true
# The web app, where the browser goes back to after linking an account
APP_WEB_URL=http://127.0.0.1:5173

# Server, read by `bin/entrypoint.sh`
APP_HOST=0.0.0.0
APP_PORT=8081
APP_LOOP=uvloop
APP_HTTP=httptools
APP_WORKERS=1

# Read by uvicorn itself
# FORWARDED_ALLOW_IPS=127.0.0.1

# Database, all required but the port, the local one is on 5433 so it runs next to other projects
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
DATABASE_USER=playou
DATABASE_PASSWORD=playou
DATABASE_NAME=playou
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=3
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_POOL_PRE_PING=true

# Redis, the local one is on 6380
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_DB=0
# REDIS_PASSWORD=
REDIS_CACHE_TTL_SECONDS=300
REDIS_TIMEOUT_SECONDS=1
REDIS_CONNECT_TIMEOUT_SECONDS=1
REDIS_RETRIES=1
REDIS_HEALTH_CHECK_SECONDS=30
REDIS_MAX_CONNECTIONS=100

# Error tracking, off without a dsn
# ERROR_TRACKING_DSN=
ERROR_TRACKING_TRACES_SAMPLE_RATE=0.1
ERROR_TRACKING_LOGS_ENABLED=true

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_TIMEOUT_SECONDS=0.5
RATE_LIMIT_CLIENT_IP_HEADER=CF-Connecting-IP

# CORS, the web origins allowed to call the api from a browser, none by default
# CORS_ORIGINS=["http://127.0.0.1:5173"]
CORS_MAX_AGE_SECONDS=600

# Auth, sign in by an emailed code
# keys the codes' hashes, a long random string, without it one is made per process, never committed
# AUTH_SECRET=
AUTH_SESSION_DAYS=30
AUTH_SESSION_REFRESH_HOURS=24
AUTH_COOKIE_NAME=playou_session
# false only over plain http, locally
AUTH_COOKIE_SECURE=true
AUTH_CODE_MINUTES=10
AUTH_CODE_ATTEMPTS=5
AUTH_CODE_COOLDOWN_SECONDS=60
AUTH_CODES_PER_EMAIL_HOUR=5
AUTH_CODES_PER_IP_HOUR=20
AUTH_VERIFICATIONS_PER_IP_HOUR=30
# a name can change this many times in any this many days, setting the first one is free
AUTH_NAME_CHANGES=2
AUTH_NAME_CHANGE_DAYS=30
# how long a session is trusted from redis before the database is asked again
AUTH_SESSION_CACHE_SECONDS=300

# Resend, sends the codes, without a key a code is logged in DEV, and refused in PROD, never committed
# RESEND_API_KEY=
RESEND_SENDER=PlaYou <no-reply@abdosworld.com>
RESEND_TIMEOUT_SECONDS=10

# Encryption, the keys the platforms' tokens are stored with, never committed
# make one with `uv run python -c "from src.utils import make_key; print(make_key())"`
# the first one encrypts, all of them decrypt, so a new key goes first, and the old one stays until nothing uses it
# ENCRYPTION_KEYS=["new-key","old-key"]

# Accounts
ACCOUNTS_LINK_MINUTES=10
# a token is refreshed this long before it expires
ACCOUNTS_REFRESH_MARGIN_SECONDS=60
# the expiring accounts job refreshes the accounts whose refresh token expires within this many days,
# on the platforms whose refresh extends it, spotify's does not
ACCOUNTS_KEEP_ALIVE_DAYS=14
ACCOUNTS_KEEP_ALIVE_BATCH_SIZE=500
# the users whose account expires within this many days are emailed to reconnect it, once an expiry
ACCOUNTS_EXPIRY_WARNING_DAYS=7
# an account refused this long is unlinked, and what came only from it removed, false keeps them
ACCOUNTS_FORGET_DISCONNECTED=true
ACCOUNTS_FORGET_DISCONNECTED_DAYS=7

# Search
SEARCH_PLATFORM_TIMEOUT_SECONDS=5
SEARCH_CACHE_SECONDS=60
# the platforms searched on demand, youtube, are cached for everyone this long
SEARCH_SHARED_CACHE_SECONDS=86400

# Sync, pushing the library to the platforms
SYNC_PUSH_BATCH_SIZE=100
SYNC_MAX_ATTEMPTS=8
# a failed push waits this long, doubled each attempt, up to the longest
SYNC_RETRY_SECONDS=30
SYNC_LONGEST_RETRY_SECONDS=3600
# an account that has to be linked again is tried again after this long
SYNC_RECONNECT_RETRY_SECONDS=3600
SYNC_RETENTION_DAYS=30
# a push is taken again after this long, if the one running it crashed, it renews it every third of it while it runs
SYNC_LEASE_SECONDS=60

# The sync worker, `bin/jobs.sh worker`, pushes, imports and copies as they are asked for
WORKER_CONCURRENCY=4
# what is due, retries, scheduled imports and paused copies, is swept this often
WORKER_SWEEP_SECONDS=15
# the api hands work over only while the worker beat within three of these
WORKER_HEARTBEAT_SECONDS=5
WORKER_WAIT_SECONDS=5
# pushes have their own slots, so long imports and copies cannot hold them up
WORKER_PUSH_CONCURRENCY=4
# on SIGTERM, running work gets this long to finish, under the container's stop grace period
WORKER_STOP_SECONDS=45
# touched every heartbeat, for the container's health check, in the temp directory, /tmp in the image
# WORKER_HEALTH_FILE=/tmp/playou-worker-alive

# Imports, the platforms' libraries
# opening the library asks for an import when the last is older than this
IMPORT_STALE_MINUTES=10
# and checks for it at most this often a user
IMPORT_CHECK_SECONDS=60
# sync now does nothing within this long of the last import, so tapping it again cannot flood spotify
IMPORT_COOLDOWN_SECONDS=60
# true also joins a song written in Arabic on one app and in Latin letters on the other, إزاي and Ezay, by how they sound
CATALOG_MATCH_ACROSS_SCRIPTS=false
# a copy to another app searches this many songs a run, and a "find similar" keeps its songs this long
CATALOG_COPY_BATCH_SIZE=25
CATALOG_CANDIDATES_SECONDS=3600
# the job imports the accounts not imported for this long
IMPORT_EVERY_MINUTES=30
# liked songs are read whole this often, to catch the ones unliked there
IMPORT_FULL_EVERY_HOURS=24
# an import is taken again after this long, if the one running it crashed
IMPORT_LEASE_MINUTES=15
IMPORT_BATCH_SIZE=10
# the due accounts asked for an import a run, the batch above is how many of them run
IMPORT_SCHEDULE_BATCH_SIZE=500

# Spotify, from the developer dashboard, off without a client id
# the redirect uri has to be added to the app in the dashboard, exactly
# SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8081/accounts/spotify/callback
SPOTIFY_TIMEOUT_SECONDS=10
# how long a refresh token lasts, the app's dashboard says it, 6 months from the link, a refresh does not extend it
SPOTIFY_REFRESH_TOKEN_DAYS=180
# the most results spotify answers a search with, it refuses more
SPOTIFY_SEARCH_MAX_LIMIT=10
# the pause after a 429 that does not say how long, with Retry-After
SPOTIFY_RATE_LIMIT_SECONDS=30
# a copy to spotify searches this many songs at a time
SPOTIFY_COPY_SEARCHES=4

# YouTube Music, from a google cloud project with the youtube data api v3, off without the client and the key
# the oauth client is a web application one, its redirect uri has to be added to it, exactly, never committed
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://127.0.0.1:8081/accounts/youtube/callback
# search is made with the api key, so its results are no one's and cached for everyone, never committed
# YOUTUBE_API_KEY=
# google's units a day for the whole project, a search is 100
YOUTUBE_DAILY_QUOTA=10000
# false searches youtube with the others on every search, a search is 100 units, only once the quota is raised
YOUTUBE_SEARCH_ON_DEMAND=true
# a copy to youtube searches this many songs at a time, each is 100 units
YOUTUBE_COPY_SEARCHES=2
# each account's share of it for pushing a day, a like or a playlist change is 50, over it the push waits for tomorrow
YOUTUBE_DAILY_PUSH_UNITS=1000
# finding songs for a copy, or similar ones, from each account's own share, a search costs 101 units
YOUTUBE_DAILY_FIND_UNITS=1000
# liked songs are copied to youtube music only when this is on, a like costs a search and a write
YOUTUBE_COPY_LIKES=false
# testing only: keeps youtube playing when the phone hides the app, against youtube's api rules, keep it off for users and for google's review
YOUTUBE_BACKGROUND_PLAY=false
# 7 while the google app is in testing, its refresh tokens last a week, leave it out once verified
# YOUTUBE_REFRESH_TOKEN_DAYS=7
YOUTUBE_TIMEOUT_SECONDS=10
# the pause after a 429 that does not say how long, with Retry-After
YOUTUBE_RATE_LIMIT_SECONDS=30

# Data, whether users may delete their data and their account themselves, deleting never touches the platforms
# when off, an erasure request is `bin/jobs.sh delete_user_data <email> --account`
DATA_DELETION_ENABLED=true

# Playback, a session untouched this long is dropped by prune_auth
PLAYBACK_SESSION_DAYS=30

# Shares, how many links a user may make an hour, and how long the public share read is cached
SHARES_PER_USER_HOUR=60
SHARES_PUBLIC_CACHE_SECONDS=300
# a song's preview image is kept in redis this long, and browsers and cloudflare may keep it this many seconds
SHARES_IMAGE_CACHE_DAYS=7
SHARES_IMAGE_MAX_AGE_SECONDS=86400

# Lyrics, from LRCLIB and saved per song, turning them off hides them everywhere at once
LYRICS_ENABLED=true
LYRICS_LRCLIB_URL=https://lrclib.net/api
LYRICS_TIMEOUT_SECONDS=5
# how long a saved answer is trusted before LRCLIB is asked again: lyrics found, none found, reported wrong
LYRICS_FOUND_DAYS=90
LYRICS_MISSING_DAYS=14
LYRICS_HIDDEN_DAYS=30
LYRICS_REPORTS_PER_USER_HOUR=5
# hide lyrics for everyone once this many people report the same lyrics wrong, 0 never does,
# `bin/jobs.sh lyrics_reports` lists the reports and `bin/jobs.sh hide_lyrics <track_id>` hides by hand
LYRICS_HIDE_AFTER_REPORTS=0

# Messages, between people who have exchanged a share link: how many one person may send,
# and the longest a live update request waits for something new
MESSAGES_PER_MINUTE=30
MESSAGES_PER_DAY=500
MESSAGES_LONGEST_WAIT_SECONDS=20
# Push notifications for new messages, off until both keys are set, make them with `bin/jobs.sh push_keys`
# MESSAGES_PUSH_PUBLIC_KEY=
# MESSAGES_PUSH_PRIVATE_KEY=
MESSAGES_PUSH_CONTACT=mailto:hey@abdosworld.com
MESSAGES_PUSH_TIMEOUT_SECONDS=10

# Together, songs a group of people has in common play with an effect: confetti, hearts or stars
# TOGETHER_GROUPS=[{"emails":["you@example.com","them@example.com"],"effect":"hearts"}]
# what makes a song count: liked (both liked it), playlist (it's in a playlist both have), sent (one shared it and the other opened it)
TOGETHER_REASONS=["liked","playlist","sent"]
